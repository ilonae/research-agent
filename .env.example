# Copy to .env and fill in your details

AGENT_OLLAMA_MODEL=llama3.2:3b
AGENT_OLLAMA_URL=http://localhost:11434
AGENT_MAX_PER_FEED=20

# ArXiv category slugs — see https://arxiv.org/category_taxonomy
AGENT_ARXIV_CATEGORIES=["cs.LG","cs.AI","cs.CV"]

# Optional keyword pre-filter (leave empty to use anchors only)
AGENT_KEYWORDS=[]

# Semantic filter — sentences describing your research topics
# AGENT_ANCHORS=["your first topic here","your second topic here"]

AGENT_EMBEDDING_MODEL=all-MiniLM-L6-v2
AGENT_SIMILARITY_THRESHOLD=0.35
